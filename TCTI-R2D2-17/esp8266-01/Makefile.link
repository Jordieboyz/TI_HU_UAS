# the location of the ti software directory
# common settings for Arduino Due projects
TARGET            ?= arduino_due
#SERIAL_PORT       ?= /dev/ttyACM0
CONSOLE_BAUDRATE  ?= 2400

RELATIVE          ?= .
TI-SOFTWARE       := $(RELATIVE)/..

# add hwlib
HWLIB             ?= $(TI-SOFTWARE)/hwlib
include           $(HWLIB)/makefile.inc
